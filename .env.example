# ============================================================
# EnterpriseAgentOs — Root Environment Variables
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

CONNECTION_STRING=Host=localhost;Port=5432;Database=eaos;Username=eaos;Password=eaos
REDIS=localhost:6379
FRONTEND_ORIGIN=http://localhost:3000
DATA_PROTECTION_KEY_PATH=dp-keys

SKILLGATEWAY__URL=http://localhost:5080
SKILLRUNTIME__URL=http://localhost:3001
CHANNEL_SERVICE_URL=http://localhost:3100
BROWSER_SERVICE_URL=http://localhost:18080
BROWSER_PUBLIC_VIEW_BASE_URL=http://localhost:6080

DOCKER__IMAGE=harkro123/eaos-pod-executor:latest
DOCKER__NETWORK=enterpriseagentos_default
DOCKER__SOCKETPATH=/var/run/docker.sock
DOCKER__HOST=127.0.0.1
DOCKER__PUBLISHHOSTPORT=true
KUBERNETES__NAMESPACE=default
KUBERNETES__IMAGE=harkro123/eaos-pod-executor:latest

WORKSPACESTORAGE__ENDPOINT=http://localhost:9000
WORKSPACESTORAGE__ACCESSKEY=eaos
WORKSPACESTORAGE__SECRETKEY=change-me
WORKSPACESTORAGE__BUCKET=eaos-workspaces-dev

# Only one is enough
PLATFORMKEYS__ANTHROPICAPIKEY=
PLATFORMKEYS__OPENAIAPIKEY=
PLATFORMKEYS__GEMINIAPIKEY=
PLATFORMKEYS__XAIAPIKEY=

# Optional self-hosted / custom OpenAI-compatible provider.
# Examples:
# - Ollama: CUSTOMLLMPROVIDER__BASEURL=http://localhost:11434/v1
# - vLLM:   CUSTOMLLMPROVIDER__BASEURL=http://localhost:8000/v1
# API key is optional for local runtimes; when set it is sent as Bearer auth.
CUSTOMLLMPROVIDER__BASEURL=
CUSTOMLLMPROVIDER__APIKEY=
CUSTOMLLMPROVIDER__MODELID=
CUSTOMLLMPROVIDER__DISPLAYNAME=Self-hosted
CUSTOMLLMPROVIDER__MODELDISPLAYNAME=
CUSTOMLLMPROVIDER__COSTWEIGHT=20
