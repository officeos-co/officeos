type Query {
  agents: [Agent!]!
}

type Mutation {
  recordToolInvocation(input: RecordToolInvocationInput!): ToolInvocation!
}

type Agent {
  id: ID!
  name: String!
  status: AgentStatus!
  createdAt: String!
  toolInvocations: [ToolInvocation!]!
}

type ToolInvocation {
  id: ID!
  agentId: ID!
  toolName: String!
  status: ToolInvocationStatus!
  failureReason: String
  createdAt: String!
}

input RecordToolInvocationInput {
  agentId: ID!
  toolName: String!
  status: ToolInvocationStatus!
  failureReason: String
}

enum AgentStatus {
  ACTIVE
  DISABLED
}

enum ToolInvocationStatus {
  SUCCEEDED
  FAILED
}
