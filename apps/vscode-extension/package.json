{
  "name": "officeos-vscode",
  "displayName": "OfficeOS",
  "description": "Browse and inspect OfficeOS control-plane resources from VS Code.",
  "version": "0.1.0",
  "publisher": "officeos",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:officeos.resources",
    "onCommand:officeos.refresh",
    "onCommand:officeos.login",
    "onCommand:officeos.currentContext",
    "onCommand:officeos.useContext",
    "onCommand:officeos.reloadResource",
    "onCommand:officeos.sendAgentMessage",
    "onCommand:officeos.showResourceLogs",
    "onCommand:officeos.describeResource",
    "onCommand:officeos.copyResourceName",
    "onCommand:officeos.deleteResource"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "contributes": {
    "configuration": {
      "title": "OfficeOS",
      "properties": {
        "officeos.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the officeos CLI. When empty, the extension uses officeos from PATH, then falls back to the repo Bun CLI in development."
        }
      }
    },
    "commands": [
      {
        "command": "officeos.refresh",
        "title": "OfficeOS: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "officeos.login",
        "title": "OfficeOS: Login"
      },
      {
        "command": "officeos.currentContext",
        "title": "OfficeOS: Show Current Context"
      },
      {
        "command": "officeos.useContext",
        "title": "OfficeOS: Use Context"
      },
      {
        "command": "officeos.reloadResource",
        "title": "OfficeOS: Reload",
        "icon": "$(refresh)"
      },
      {
        "command": "officeos.sendAgentMessage",
        "title": "OfficeOS: Send Message",
        "icon": "$(send)"
      },
      {
        "command": "officeos.showResourceLogs",
        "title": "OfficeOS: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "officeos.describeResource",
        "title": "OfficeOS: Description",
        "icon": "$(open-preview)"
      },
      {
        "command": "officeos.copyResourceName",
        "title": "OfficeOS: Copy Resource Name",
        "icon": "$(copy)"
      },
      {
        "command": "officeos.deleteResource",
        "title": "OfficeOS: Delete Resource",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "officeos.refresh",
          "when": "view == officeos.resources",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "officeos.reloadResource",
          "when": "view == officeos.resources && viewItem == officeosCategory",
          "group": "inline"
        },
        {
          "command": "officeos.reloadResource",
          "when": "view == officeos.resources && (viewItem == officeosResource || viewItem == officeosDeletableResource)",
          "group": "inline"
        },
        {
          "command": "officeos.sendAgentMessage",
          "when": "view == officeos.resources && viewItem == officeosAgentResource",
          "group": "navigation@1"
        },
        {
          "command": "officeos.showResourceLogs",
          "when": "view == officeos.resources && (viewItem == officeosResource || viewItem == officeosDeletableResource || viewItem == officeosAgentResource)",
          "group": "navigation@2"
        },
        {
          "command": "officeos.describeResource",
          "when": "view == officeos.resources && (viewItem == officeosResource || viewItem == officeosDeletableResource || viewItem == officeosAgentResource)",
          "group": "navigation@3"
        },
        {
          "command": "officeos.copyResourceName",
          "when": "view == officeos.resources && (viewItem == officeosResource || viewItem == officeosDeletableResource || viewItem == officeosAgentResource)",
          "group": "navigation@4"
        },
        {
          "command": "officeos.deleteResource",
          "when": "view == officeos.resources && (viewItem == officeosDeletableResource || viewItem == officeosAgentResource)",
          "group": "destructive"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "officeos",
          "title": "OfficeOS",
          "icon": "resources/officeos.svg"
        }
      ]
    },
    "views": {
      "officeos": [
        {
          "id": "officeos.resources",
          "name": "Resources",
          "when": "true"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.8.2"
  }
}
