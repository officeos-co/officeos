# ============================================================
# EnterpriseAgentOs Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .NET uses __ (double underscore) as section separator.
# These override values in appsettings.json at runtime.
# ============================================================

# === Core ===
ASPNETCORE_ENVIRONMENT=Development
ConnectionString=Host=localhost;Port=5432;Database=eaos_dev;Username=contentmachine;Password=eaos
Redis=localhost:6379
FrontendOrigin=http://localhost:3000
DataProtectionKeyPath=dp-keys

# === Kubernetes (enable for K8s deployments) ===
Kubernetes__Enabled=false
Kubernetes__Namespace=default
Kubernetes__Image=harkro123/eaos-pod-executor:latest

# === Docker (local dev alternative to K8s) ===
Docker__Enabled=true
Docker__Image=harkro123/eaos-pod-executor:latest
Docker__Network=enterpriseagentos_default
Docker__SocketPath=/var/run/docker.sock

# === Service URLs ===
SkillGateway__Url=http://localhost:5080
SkillRuntime__Url=http://localhost:3001

# === Google OAuth ===
GoogleOAuth__ClientId=
GoogleOAuth__ClientSecret=
GoogleOAuth__RedirectUri=http://localhost:3000/api/auth/callback/google
GoogleOAuth__SkillOAuthRedirectUri=http://localhost:3000/api/skills/oauth/google/callback

# === Object Storage (MinIO / S3-compatible) ===
Minio__Endpoint=
Minio__AccessKey=
Minio__SecretKey=
Minio__Bucket=skills

# === Stripe Billing ===
Stripe__Enabled=false
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__FreePriceId=
Stripe__ProMonthlyPriceId=
Stripe__ProYearlyPriceId=
Stripe__TeamMonthlyPriceId=
Stripe__TeamYearlyPriceId=
Stripe__FreeOveragePriceId=
Stripe__ProOveragePriceId=
Stripe__TeamOveragePriceId=

# === LLM Platform Keys (optional — users can BYOK via dashboard) ===
PlatformKeys__AnthropicApiKey=
PlatformKeys__OpenAiApiKey=
PlatformKeys__GeminiApiKey=
PlatformKeys__XaiApiKey=

# === PostHog Analytics ===
PostHog__Enabled=false
PostHog__ApiKey=
PostHog__Host=https://eu.i.posthog.com
