# ============================================================
# EnterpriseAgentOs Backend — Environment Variables
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

CONNECTION_STRING=Host=localhost;Port=5432;Database=YOUR_COOL_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD
REDIS=localhost:6379
FRONTEND_ORIGIN=http://localhost:3000
DATA_PROTECTION_KEY_PATH=dp-keys

SKILLGATEWAY__URL=http://localhost:5080
SKILLRUNTIME__URL=http://localhost:3001
CHANNEL_SERVICE_URL=http://localhost:3100

# === Daytona Sandbox ===
# Run Daytona separately with its official Docker Compose stack.
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=
DAYTONA_TIMEOUT_SECONDS=60
DAYTONA_WORKDIR=/workspace

PLATFORMKEYS__ANTHROPICAPIKEY=
PLATFORMKEYS__OPENAIAPIKEY=
PLATFORMKEYS__GEMINIAPIKEY=
PLATFORMKEYS__XAIAPIKEY=
