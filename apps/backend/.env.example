# ============================================================
# EnterpriseAgentOs Backend — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# .NET uses __ (double underscore) as section separator.
#
# Google OAuth, Docker config, SessionAuth prefixes, and
# RateLimiting have sensible defaults in appsettings.json.
# ============================================================

# === Required ===
CONNECTION_STRING=Host=localhost;Port=5432;Database=eaos;Username=eaos;Password=eaos
REDIS=localhost:6379
FRONTEND_ORIGIN=http://localhost:3000
DATA_PROTECTION_KEY_PATH=dp-keys

# === Service URLs ===
SKILLGATEWAY__URL=http://localhost:5080
SKILLRUNTIME__URL=http://localhost:3001
CHANNEL_SERVICE_URL=http://localhost:3100

# === LLM Provider Keys (at least one required for agents to work) ===
PLATFORMKEYS__ANTHROPICAPIKEY=
PLATFORMKEYS__OPENAIAPIKEY=
PLATFORMKEYS__GEMINIAPIKEY=
PLATFORMKEYS__XAIAPIKEY=
