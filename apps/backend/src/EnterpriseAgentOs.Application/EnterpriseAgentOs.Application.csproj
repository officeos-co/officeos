<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnterpriseAgentOs.Application</RootNamespace>
    <AssemblyName>EnterpriseAgentOs.Application</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EnterpriseAgentOs.Domain\EnterpriseAgentOs.Domain.csproj" />
    <!-- Pragmatic: services reference EaosDbContext and Infrastructure helpers directly.
         This architectural violation will be resolved in a later refactor. -->
    <ProjectReference Include="..\EnterpriseAgentOs.Infrastructure\EnterpriseAgentOs.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed for ITopicEventSender in AgentLogService and GraphQLName attribute in DTOs -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="14.3.0" />
    <PackageReference Include="Stripe.net" Version="51.0.0" />
  </ItemGroup>
</Project>
