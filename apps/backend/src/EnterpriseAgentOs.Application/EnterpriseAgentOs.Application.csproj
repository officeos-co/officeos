<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnterpriseAgentOs.Application</RootNamespace>
    <AssemblyName>EnterpriseAgentOs.Application</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EnterpriseAgentOs.Domain\EnterpriseAgentOs.Domain.csproj" />
    <!-- Application still references Infrastructure for config classes (StripeConfig, FrontendConfig),
         protectors (ProviderKeyProtector, SkillCredentialProtector), and adapters (SkillRuntimeClient).
         DbContext access has been eliminated — all data access goes through Domain repository interfaces. -->
    <ProjectReference Include="..\EnterpriseAgentOs.Infrastructure\EnterpriseAgentOs.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed for ITopicEventSender in AgentLogService and GraphQLName attribute in DTOs -->
    <PackageReference Include="Cronos" Version="0.12.0" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="14.3.0" />
    <PackageReference Include="Stripe.net" Version="51.0.0" />
  </ItemGroup>
</Project>
