{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Docker": {
    "Enabled": true,
    "Image": "harkro123/eaos-pod-executor:latest",
    "Network": "enterpriseagentos_default",
    "SocketPath": "/var/run/docker.sock"
  },
  "SessionAuth": {
    "SkipPrefixes": [
      "/api/auth/google",
      "/api/auth/callback",
      "/api/auth/logout",
      "/api/health",
      "/healthz",
      "/api/graphql",
      "/api/agents/me/",
      "/api/runner/register",
      "/api/runner/jobs",
      "/api/runner/heartbeat",
      "/api/runner/skills",
      "/api/runner/device/code",
      "/api/runner/device/token",
      "/api/billing/webhook",
      "/api/internal"
    ]
  },
  "RateLimiting": {
    "SkillExecPerAgentPerHour": 60,
    "EmailPerAgentPerHour": 10,
    "WindowSeconds": 3600
  }
}
