{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SessionAuth": {
    "SkipPrefixes": [
      "/api/health",
      "/healthz",
      "/api/graphql",
      "/api/agents/me/",
      "/api/runner/register",
      "/api/runner/jobs",
      "/api/runner/heartbeat",
      "/api/runner/skills",
      "/api/runner/device/code",
      "/api/runner/device/token",
      "/api/internal"
    ]
  },
  "RateLimiting": {
    "SkillExecPerAgentPerHour": 60,
    "EmailPerAgentPerHour": 10,
    "WindowSeconds": 3600
  }
}
