# Single switch: dev | staging | production.
# URLs (base_url, cors_origins) are picked from the hardcoded PROFILES
# table in app/core/config.py — do NOT set BASE_URL / CORS_ORIGINS here.
ENVIRONMENT=production

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_USE_UTC=false
REQUEST_LOG_SLOW_MS=1000
REQUEST_LOG_INCLUDE_HEALTH=false

DATABASE_URL=postgresql+psycopg://eaos:eaos@db:5432/enterprise_agent_os
DB_AUTO_MIGRATE=true

SECURITY_HEADER_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADER_X_FRAME_OPTIONS=DENY
SECURITY_HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADER_PERMISSIONS_POLICY=

AUTH_MODE=google
LOCAL_AUTH_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING_AT_LEAST_50_CHARS_LONG

# ── Google OAuth ─────────────────────────────────────────────
# Client ID/secret are shared across all environments (one Google
# OAuth app, multiple registered redirect URIs). The redirect_uri
# itself is NOT here — it's selected per-environment from the
# PROFILES table in app/core/config.py.
#
# SECURITY: this committed file contains a real client_secret. If
# you rotate the Google app, bump the value here too. If the repo
# ever goes public, rotate the secret first.
GOOGLE_CLIENT_ID=1065208938503-d1mo21cn8a7adi2t6t1vard4rl7ia35c.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# SESSION_SECRET is used to sign the JWT returned after Google sign-in.
# Regenerate with `openssl rand -hex 32` if you rotate.
SESSION_SECRET=dev-local-session-secret-change-me-in-prod-replace-with-32-byte-hex

RQ_REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=default
RQ_DISPATCH_THROTTLE_SECONDS=15.0
RQ_DISPATCH_MAX_RETRIES=3

GATEWAY_MIN_VERSION=2026.02.9

# ── CouchDB vault ────────────────────────────────────────────
# Connection to the per-agent Obsidian vault (and the /api/vault
# browser used by the dashboard Vault tab).
ZEROCLAW_VAULT_HOST=couchdb
ZEROCLAW_VAULT_PORT=5984
ZEROCLAW_VAULT_USERNAME=eaos
ZEROCLAW_VAULT_PASSWORD=eaos
ZEROCLAW_VAULT_PROTOCOL=http
