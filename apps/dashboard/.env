# `auto` => `lib/api-base.ts` resolves the backend URL at runtime from
# `window.location.hostname:8000`, which makes a single baked image
# work for both `docker compose up` (localhost) and a real deploy
# behind a reverse proxy without rebuilding. If you want to pin the
# dashboard to a specific absolute backend, replace with that URL.
NEXT_PUBLIC_API_URL=auto
NEXT_PUBLIC_AUTH_MODE=google
