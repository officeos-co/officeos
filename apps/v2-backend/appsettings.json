{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Production": {
    "ConnectionString": "Data Source=/data/eaos.db",
    "FrontendOrigin": "https://dashboard.harrokrog.com",
    "KubernetesEnabled": true,
    "KubernetesNamespace": "default",
    "ZeroclawImage": "harkro123/zeroclaw:latest",
    "DataProtectionKeyPath": "/data/dp-keys",
    "CouchDbUrl": "http://eaos-couchdb:5984",
    "CouchDbUser": "eaos",
    "CouchDbPassword": "eaos"
  },
  "Staging": {
    "ConnectionString": "Data Source=eaos.db",
    "DataProtectionKeyPath": "dp-keys",
    "FrontendOrigin": "http://localhost:5173",
    "KubernetesEnabled": false,
    "KubernetesNamespace": "default",
    "ZeroclawImage": "harkro123/zeroclaw:latest",
    "CouchDbUrl": "http://eaos-couchdb:5984",
    "CouchDbUser": "eaos",
    "CouchDbPassword": "eaos"
  }
}
